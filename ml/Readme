---

## Quick Inference

```python
import torch
from transformers import AutoTokenizer, AutoModel
from model import SiameseBERT

tokenizer = AutoTokenizer.from_pretrained('./trainedModel/tokenizer')
bert_model = AutoModel.from_pretrained('./trainedModel/bert_config')
model = SiameseBERT(bert_model, num_classes=3, dropout_rate=0.3, pooling_strategy='mean')
model.load_state_dict(torch.load('./trainedModel/siamese_model.pth')['model_state_dict'])
model.eval()

req1 = "The UAV shall operate within 10 km."
req2 = "The drone must stay within 10 kilometers of the controller."

inputs1 = tokenizer(req1, return_tensors='pt', truncation=True, padding=True)
inputs2 = tokenizer(req2, return_tensors='pt', truncation=True, padding=True)

with torch.no_grad():
    outputs = model(**inputs1, **inputs2)
    print(torch.argmax(outputs, dim=1))
```

